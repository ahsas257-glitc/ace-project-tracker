# Copy these into Streamlit Cloud: your app -> Settings -> Secrets.
# Never commit a real secrets.toml to GitHub.

viewer_password = "choose-a-password-for-executives"
editor_password = "choose-a-password-for-project-officers"

# The long ID in your Google Sheet's link: docs.google.com/spreadsheets/d/<THIS PART>/edit
sheet_key = "1qBhLSNXkW6D4e29A44q5Ry25MWlBxdkZ7RDvcz-60o4"

# Paste the fields from the service-account JSON key file you downloaded from Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "ace-tracker@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
